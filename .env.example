# Variables d'environnement (jamais de valeur réelle dans ce fichier : copier vers .env)

# Connexion n8n : chaque demande de chantier et candidature d'artisan y est envoyée en JSON (POST).
# n8n envoie ensuite l'e-mail. Sans cette URL au build, les formulaires ouvrent la messagerie du visiteur.
LEADS_WEBHOOK_URL=
# Secret partagé, envoyé dans l'en-tête X-Webhook-Secret (credential "Header Auth" côté n8n).
LEADS_WEBHOOK_SECRET=

INDEXING=            # "off" pour une préproduction
INDEXNOW_KEY=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
